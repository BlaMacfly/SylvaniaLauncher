# Files executed on Linux MUST keep LF endings even when the repository is
# checked out on Windows (the Docker build mounts the Windows working tree:
# CRLF in a bash script breaks it with "\r: command not found").
*.sh            text eol=lf
linux/AppRun    text eol=lf
linux/Dockerfile text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.desktop       text eol=lf

# Binary assets: never normalise.
*.png  binary
*.jpg  binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.zip  binary
*.chunks binary
